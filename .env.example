# Server-only secrets. Never prefix these names with VITE_.
# This file lists names only — put real values in the host Secrets, not in git.

# Target administration (phase 4): Gemini + Google Auth allow-list.
GEMINI_API_KEY=
GEMINI_MODEL=
ADMIN_EMAILS=
AI_VISION=

# Optional Firebase identifiers for the server (phase 4). Not client public keys.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Current server still uses these until phase 4 replaces Redis/password auth.
ADMIN_PASSWORD=
ADMIN_SECRET=
AI_API_URL=
AI_API_KEY=
AI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative Vercel KV pair (leave blank when using Upstash variables).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
