# Server-only administration credentials. Never prefix these with VITE_.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# At least 32 characters. Rotating it invalidates all admin sessions.
ADMIN_SECRET=replace-with-at-least-32-random-characters
# Optional server-only AI analysis provider. These must never use a VITE_ prefix.
AI_API_URL=https://your-ai-provider.example/v1/chat/completions
AI_API_KEY=replace-with-server-only-ai-key
AI_MODEL=your-model-name

# Use exactly one complete Redis credential pair.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Alternative Vercel KV pair (leave blank when using Upstash variables).
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token
