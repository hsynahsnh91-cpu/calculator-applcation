# Server-only secrets. Never prefix these names with VITE_.
# This file lists names only — put real values in the host Secrets, not in git.

# Phase 4: Gemini on the server. The student app never reads these.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_VISION=

# Phase 4: Google sign-in allow-list. Comma-separated emails. Never hardcode in source.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 4: Firestore from the server (service account). Not client public keys.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cookie signing remains required even with Google login (32+ characters).
ADMIN_SECRET=

# Optional fallbacks. Password login still works if set. Redis still rate-limits when set.
ADMIN_PASSWORD=
AI_API_URL=
AI_API_KEY=
AI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative Vercel KV pair (leave blank when using Upstash variables).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
